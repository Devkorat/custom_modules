<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Barcode Kiosk User Group -->
        <record id="group_barcode_kiosk_user" model="res.groups">
            <field name="name">Barcode Kiosk User</field>
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="comment">User can access and operate the barcode kiosk</field>
        </record>

        <!-- Barcode Kiosk Manager Group -->
        <record id="group_barcode_kiosk_manager" model="res.groups">
            <field name="name">Barcode Kiosk Manager</field>
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
            <field name="implied_ids" eval="[(4, ref('group_barcode_kiosk_user')), (4, ref('stock.group_stock_manager'))]"/>
            <field name="comment">User can manage kiosk sessions and configure settings</field>
        </record>

        <!-- Record Rules -->
        <record id="barcode_kiosk_session_user_rule" model="ir.rule">
            <field name="name">Barcode Kiosk Session: User Access</field>
            <field name="model_id" ref="model_barcode_kiosk_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_barcode_kiosk_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="barcode_kiosk_session_manager_rule" model="ir.rule">
            <field name="name">Barcode Kiosk Session: Manager Access</field>
            <field name="model_id" ref="model_barcode_kiosk_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_barcode_kiosk_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

    </data>
</odoo>
