<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Main Kiosk Interface Template -->
    <t t-name="kx_barcode_operations_kiosk.KioskInterface" owl="1">
        <div class="barcode_kiosk_interface">
            <!-- Header -->
            <div class="barcode_kiosk_header">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <div class="header_left">
                            <h1>
                                <i class="fa fa-barcode"/> Barcode Kiosk
                            </h1>
                            <div class="session_info" t-if="state.sessionId">
                                Session: <strong t-esc="state.sessionName"/>
                                <span t-if="state.operationType"> | </span>
                                <span t-if="state.operationType" t-esc="getOperationTypeLabel(state.operationType)"/>
                                <span t-if="state.pickingName"> | <i class="fa fa-cube"/> <t t-esc="state.pickingName"/></span>
                            </div>
                        </div>
                        <div class="header_center">
                            <div t-if="state.isInternal and state.sessionId" class="d-flex gap-2">
                                <button target="_blank" class="btn btn-dark btn-sm" t-on-click="openBackendSessions">
                                    <i class="fa fa-desktop"/> Backend
                                </button>
                                <!-- <button class="btn btn-info" t-on-click="openScanRecords">
                                    <i class="fa fa-list-alt"/> View All Scans
                                </button> -->
                                <button class="btn btn-light" t-on-click="closeSession">
                                    <i class="fa fa-sign-out"/> Close Session
                                </button>
                            </div>
                        </div>
                        <div t-if="state.sessionId" class="user_info header_right">
                            <div class="w-100 d-flex align-items-center">
                                <div>
                                    <img t-if="state.avatar"
                                        t-att-src="state.avatar"
                                        class="rounded-circle"
                                        style="width: 30px; height: 30px; border: 1px solid #ddd;" />
                                </div>
                                <div class="user_details ms-2 text-end">
                                    <t t-esc="state.userName"/><br/>
                                    <p class="mb-0 text-end"><t t-esc="state.role"/></p>
                                </div>
                            </div>
                            <div class="pt-2 text-end">
                                <!-- Logout -->
                                <a href="/web/session/logout" class="btn btn-outline-danger btn-sm">
                                    <i class="fa fa-power-off"/> Logout
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div class="barcode_kiosk_content">
                
                <!-- Operation Selector (shown when no session) -->
                <div t-if="state.showOperationSelector" class="operation_selector">
                    <h2>Select Operation Type</h2>
                    <div class="operation_buttons">
                        <button class="operation_btn" t-on-click="() => this.startSession('incoming')">
                            <i class="fa fa-sign-in"/>
                            Incoming<br/>(Receipts)
                        </button>
                        <button class="operation_btn" t-on-click="() => this.startSession('outgoing')">
                            <i class="fa fa-sign-out"/>
                            Outgoing<br/>(Deliveries)
                        </button>
                        <button class="operation_btn" t-on-click="() => this.startSession('internal')">
                            <i class="fa fa-exchange"/>
                            Internal<br/>Transfers
                        </button>
                        <button class="operation_btn" t-on-click="() => this.startSession('incoming')">
                            <i class="fa fa-undo"/>
                            Returns
                        </button>
                        <button class="operation_btn" t-on-click="() => this.startSession('scrap')">
                            <i class="fa fa-trash"/>
                            Scrap
                        </button>
                    </div>
                </div>

                <!-- Scanning Interface (shown when session is active) -->
                <div t-if="!state.showOperationSelector" class="scanning_interface">
                    
                    <!-- Operation Type Warning Banner -->
                    <div t-if="state.sessionId and state.operationType" 
                        class="alert alert-info mb-3 d-flex align-items-center justify-content-between"
                        style="border-left: 4px solid #0dcaf0;">
                        <div>
                            <h5 class="mb-1">
                                <i class="fa fa-info-circle"/> Active Session: 
                                <strong><t t-esc="getOperationTypeLabel(state.operationType)"/></strong>
                            </h5>
                            <small class="text-muted">
                                <i class="fa fa-exclamation-triangle"/> Only scan 
                                <strong><t t-esc="getOperationTypeLabel(state.operationType)"/></strong> 
                                pickings and their products
                            </small>
                        </div>
                        <div>
                            <span t-attf-class="badge badge-lg {{getOperationTypeBadgeClass(state.operationType)}}" 
                                style="font-size: 1.1em; padding: 8px 15px;">
                                <i t-attf-class="fa {{getOperationTypeIcon(state.operationType)}}"/> 
                                <t t-esc="state.operationType.toUpperCase()"/>
                            </span>
                        </div>
                    </div>

                    <!-- Enhanced Scanned Items List with Error Highlighting -->
                    <!-- Scan Input -->
                    <div class="scan_input_section">
                        <h3><i class="fa fa-barcode"/> Scan Barcode</h3>
                        <div class="scan_input_wrapper">
                            <input 
                                type="text" 
                                t-ref="barcodeInput"
                                t-model="state.currentBarcode"
                                t-on-keyup="onBarcodeInput"
                                placeholder="Scan or enter barcode..."
                                autocomplete="off"
                                autofocus="true"/>
                            <button class="btn_success" t-on-click="() => this.processBarcode(state.currentBarcode)">
                                <i class="fa fa-check"/> Scan
                            </button>
                            <button class="btn_primary" t-on-click="validateOperation" t-if="state.pickingId">
                                <i class="fa fa-check-square-o"/> Validate
                            </button>
                        </div>
                    </div>

                    <!-- Statistics -->
                    <div class="stats_section">
                        <div class="stat_card">
                            <div class="stat_value" t-esc="state.totalScans"/>
                            <div class="stat_label">Total Scans</div>
                        </div>
                        <div class="stat_card">
                            <div class="stat_value" style="color: #28a745;" t-esc="state.successfulScans"/>
                            <div class="stat_label">Successful</div>
                        </div>
                        <div class="stat_card">
                            <div class="stat_value" style="color: #dc3545;" t-esc="state.failedScans"/>
                            <div class="stat_label">Failed</div>
                        </div>
                    </div>

                    <!-- Two Column Layout -->
                    <div class="row">
                        <!-- Left Column: Recent Scanned Items -->
                        <div class="col-md-6">
                            <div class="scanned_items_section">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h3 class="mb-0"><i class="fa fa-list"/> Recent Scans (<t t-esc="state.scannedItems.length"/>)</h3>
                                    <button class="btn btn-sm btn-info" t-on-click="openScanRecords" t-if="state.scannedItems.length > 0">
                                        <i class="fa fa-external-link"/> View All
                                    </button>
                                </div>
                                <div class="scanned_items_list">
                                    <div t-if="state.scannedItems.length === 0" style="padding: 40px; text-align: center; color: #999;">
                                        <i class="fa fa-inbox" style="font-size: 48px; margin-bottom: 15px;"/>
                                        <p>No items scanned yet. Start scanning to see items here.</p>
                                    </div>
                                    <div t-foreach="state.scannedItems" t-as="item" t-key="item_index" 
                                         t-attf-class="scanned_item {{item.status}}"
                                         t-on-click="() => this.openScanDetail(item)">
                                        <div class="item_icon">
                                            <i t-if="item.status === 'success'" class="fa fa-check-circle"/>
                                            <i t-if="item.status === 'error'" class="fa fa-times-circle"/>
                                        </div>
                                        <div class="item_details">
                                            <div class="item_product" t-esc="item.product_name"/>
                                            <div class="item_barcode">
                                                <i class="fa fa-barcode"/> <t t-esc="item.barcode"/>
                                                <span t-if="item.type" class="badge badge-info ml-2" t-esc="item.type.toUpperCase()"/>
                                            </div>
                                            <div class="item_quantity" t-if="item.quantity">
                                                Qty: <t t-esc="item.quantity"/> / <t t-esc="item.expected"/>
                                            </div>
                                            <div t-if="item.picking_name" class="text-muted small">
                                                <i class="fa fa-cube"/> <t t-esc="item.picking_name"/>
                                            </div>
                                            <div t-if="item.partner" class="text-muted small">
                                                <i class="fa fa-user"/> <t t-esc="item.partner"/>
                                            </div>
                                            <div class="item_message text-danger" t-if="item.message" t-esc="item.message"/>
                                        </div>
                                        <div class="item_time" t-esc="item.time"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: All Pickings -->
                        <div class="col-md-6">
                            <div class="picking-card-grid">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h3><i class="fa fa-cubes"/> All Pickings</h3>
                                    <button class="btn btn-sm btn-secondary" t-on-click="loadAllPickings">
                                        <i class="fa fa-refresh"/> Refresh
                                    </button>
                                </div>

                                <div class="row">
                                    <div t-if="state.allPickings.length === 0" class="text-center text-muted p-4">
                                        <i class="fa fa-inbox fa-2x mb-2"/>
                                        <p>No pickings found.</p>
                                    </div>

                                    <!-- Fixed: Properly close all tags -->
                                    <t t-foreach="state.allPickings" t-as="p" t-key="p.id">
                                        <div class="col-md-12 mb-3">
                                            
                                            <!-- Add conditional class based on scanned status -->
                                            <div t-attf-class="card shadow-sm p-3 picking-card {{p.is_scanned ? 'scanned-picking' : 'readonly-picking'}}"
                                                t-on-click="() => this.openPickingDetail(p)"
                                                style="cursor:pointer; position: relative;">

                                                <!-- Editable/Readonly Badge -->
                                                <!-- <div style="position: absolute; top: 10px; right: 10px;">
                                                    <t t-if="p.is_scanned">
                                                        <span class="badge badge-success">
                                                            <i class="fa fa-edit"/> Scanned - Editable
                                                        </span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge badge-secondary">
                                                            <i class="fa fa-lock"/> Read-only
                                                        </span>
                                                    </t>
                                                </div> -->

                                                <div class="d-flex justify-content-between">
                                                    <div>
                                                        <h5>
                                                            <!-- Icon changes based on scanned status -->
                                                            <t t-if="p.is_scanned">
                                                                <i class="fa fa-check-circle text-success"/>
                                                            </t>
                                                            <t t-else="">
                                                                <i class="fa fa-cube"/>
                                                            </t>
                                                            <t t-esc="p.name"/>
                                                        </h5>
                                                        <span t-attf-class="badge {{getPickingBadgeClass(p.state)}}">
                                                            <t t-esc="p.state"/>
                                                        </span>
                                                    </div>
                                                    <div class="text-muted small">
                                                        <i class="fa fa-user"/> <t t-esc="p.partner_name"/>
                                                    </div>
                                                </div>

                                                <div class="mt-2 text-muted">
                                                    <i class="fa fa-calendar"/> <t t-esc="p.scheduled_date || 'N/A'"/>
                                                    <span class="ml-3 ml8"><i class="fa fa-tag"/> <t t-esc="p.picking_type"/></span>
                                                </div>

                                                <div class="mt-3">
                                                    <strong>Products (<t t-esc="p.move_lines.length"/>)</strong>
                                                    
                                                    <!-- Show detailed table for scanned pickings -->
                                                    <t t-if="p.is_scanned">
                                                        <div class="table-responsive mt-2">
                                                            <table class="table table-sm table-bordered">
                                                                <thead class="thead-light">
                                                                    <tr>
                                                                        <th>Product</th>
                                                                        <th style="width: 100px;">Done</th>
                                                                        <th style="width: 80px;">Expected</th>
                                                                        <th style="width: 80px;">Status</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    <t t-foreach="p.move_lines" t-as="m" t-key="m.product_id">
                                                                        <tr>
                                                                            <td>
                                                                                <div><t t-esc="m.product"/></div>
                                                                                <small class="text-muted">
                                                                                    <i class="fa fa-barcode"/> <t t-esc="m.barcode || 'No barcode'"/>
                                                                                </small>
                                                                            </td>
                                                                            <td>
                                                                                <!-- Editable input for scanned pickings -->
                                                                                <input type="number" 
                                                                                    class="form-control form-control-sm"
                                                                                    t-att-value="m.qty_done || 0"
                                                                                    t-att-data-picking-id="p.id"
                                                                                    t-att-data-product-id="m.product_id"
                                                                                    t-on-change="(ev) => this.updateQuantity(p.id, m.product_id, ev.target.value)"
                                                                                    t-on-click="(ev) => ev.stopPropagation()"
                                                                                    min="0"
                                                                                    step="1"/>
                                                                            </td>
                                                                            <td class="text-center">
                                                                                <strong><t t-esc="m.qty_total"/></strong>
                                                                            </td>
                                                                            <td class="text-center">
                                                                                <t t-if="(m.qty_done || 0) >= m.qty_total">
                                                                                    <span class="badge badge-success">
                                                                                        <i class="fa fa-check"/> Done
                                                                                    </span>
                                                                                </t>
                                                                                <t t-elif="(m.qty_done || 0) > 0">
                                                                                    <span class="badge badge-warning">
                                                                                        <i class="fa fa-hourglass-half"/> Partial
                                                                                    </span>
                                                                                </t>
                                                                                <t t-else="">
                                                                                    <span class="badge badge-secondary">
                                                                                        <i class="fa fa-circle-o"/> Pending
                                                                                    </span>
                                                                                </t>
                                                                            </td>
                                                                        </tr>
                                                                    </t>
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </t>
                                                    
                                                    <!-- Simple list for readonly pickings -->
                                                    <t t-else="">
                                                        <div class="small text-muted">
                                                            <t t-foreach="p.move_lines" t-as="m" t-key="m.product_id">
                                                                <div class="d-flex justify-content-between py-1 border-bottom">
                                                                    <span>- <t t-esc="m.product"/></span>
                                                                    <span>
                                                                        <t t-esc="m.qty_done || 0"/>/<t t-esc="m.qty_total"/>
                                                                    </span>
                                                                </div>
                                                            </t>
                                                        </div>
                                                    </t>
                                                </div>

                                                <!-- Action buttons - only show for scanned pickings -->
                                                <t t-if="p.is_scanned">
                                                    <div class="mt-3 d-flex gap-2" style="gap: 8px;">
                                                        <button class="btn btn-sm btn-primary flex-fill" 
                                                                t-on-click.stop="() => this.openPickingDetail(p)">
                                                            <i class="fa fa-edit"/> Edit Details
                                                        </button>
                                                        <t t-if="p.state !== 'done'">
                                                            <button class="btn btn-sm btn-success flex-fill" 
                                                                    t-on-click.stop="() => this.validateSinglePicking(p.id)">
                                                                <i class="fa fa-check"/> Validate
                                                            </button>
                                                        </t>
                                                        <t t-else="">
                                                            <button class="btn btn-sm btn-secondary flex-fill" 
                                                                    disabled="">
                                                                <i class="fa fa-check-circle"/> Validated
                                                            </button>
                                                        </t>
                                                    </div>
                                                </t>
                                                
                                                <!-- Message for readonly pickings -->
                                                <t t-else="">
                                                    <div class="mt-3 text-center">
                                                        <small class="text-muted">
                                                            <i class="fa fa-info-circle"/> Scan this picking's barcode to enable editing
                                                        </small>
                                                    </div>
                                                </t>

                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Loading Overlay -->
            <div t-if="state.isLoading" class="loading_overlay">
                <div class="loading_spinner">
                    <i class="fa fa-spinner fa-spin"/>
                    <p>Processing...</p>
                </div>
            </div>

        </div>
    </t>

    <!-- Barcode Handler Template -->
    <t t-name="kx_barcode_operations_kiosk.BarcodeHandler" owl="1">
        <div style="display: none;"/>
    </t>

</templates>