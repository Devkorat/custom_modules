<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Settings View -->
        <record id="res_config_settings_view_form_inherit_barcode_kiosk" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.barcode.kiosk</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <div class="app_settings_block" data_key="kx_barcode_operations_kiosk" string="Barcode Kiosk">
                        <h2>Barcode Kiosk Settings</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="kiosk_enable_sound"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="kiosk_enable_sound"/>
                                    <div class="text-muted">
                                        Play sound alerts when scanning barcodes
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="kiosk_auto_validate"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="kiosk_auto_validate"/>
                                    <div class="text-muted">
                                        Automatically validate operations when all items are scanned
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="kiosk_allow_overscanning"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="kiosk_allow_overscanning"/>
                                    <div class="text-muted">
                                        Allow scanning more than the expected quantity
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="kiosk_show_product_image"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="kiosk_show_product_image"/>
                                    <div class="text-muted">
                                        Display product images in the kiosk interface
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="kiosk_require_location_scan"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="kiosk_require_location_scan"/>
                                    <div class="text-muted">
                                        Require location scan before scanning products for internal transfers
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="kiosk_session_timeout"/>
                                    <div class="text-muted">
                                        Session timeout in minutes
                                    </div>
                                    <div class="content-group">
                                        <div class="mt16">
                                            <field name="kiosk_session_timeout" class="o_input"/>
                                            <span> minutes</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>